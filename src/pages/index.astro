---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="梧桐" pageType="website">
  <section class="hero">
    <div class="container">
      <p class="hero-eyebrow">Notes &middot; <span>since 2014</span></p>
      <h1 class="hero-title">梧桐</h1>
      <p class="hero-tagline">移动前端技术专家 / 全栈工程师</p>
      <p class="hero-desc">
        个人技术博客。关注 iOS / Android / HarmonyOS 三端、AI 与证券应用、移动端架构与工程实践。
      </p>
    </div>
  </section>

  <section class="archive">
    <div class="container">
      <h2 class="section-title">
        <span class="section-label">All posts</span>
        <span class="section-count">{posts.length} 篇文章</span>
      </h2>

      <ol class="post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 5rem 0 3rem; }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
  }
  .hero-eyebrow span { color: var(--brand); }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--text-muted);
    font-weight: 400;
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .hero-desc {
    color: var(--text-muted);
    max-width: 36em;
    font-size: 1rem;
    line-height: 1.7;
  }

  .archive { padding: 2rem 0 4rem; }

  .section-title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    margin-bottom: 2rem;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .section-label { color: var(--text-muted); }
  .section-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero { padding: 3rem 0 2rem; }
  }
</style>
