---
import BaseLayout from './BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { postSlug } from '../content/config';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'posts'>;
  headings?: Heading[];
}

const { post, headings = [] } = Astro.props;
const dateISO = post.data.date.toISOString().slice(0, 10);
const dateHuman = post.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric',
});

// Compute prev / next across all non-draft posts sorted newest-first
const all = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx < all.length - 1 ? all[idx + 1] : null; // older
const next = idx > 0 ? all[idx - 1] : null; // newer

// TOC: only h2 and h3
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

// Recent posts (exclude current)
const recentPosts = all.filter((p) => p.id !== post.id).slice(0, 5);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  pageType="article"
>
  <article class="post">
    <div class="container-wide post-layout">
      <div class="post-main">
        <header class="post-header">
          <h1 class="post-title">{post.data.title}</h1>
          <p class="post-meta">
            <time datetime={dateISO}>{dateHuman}</time>
            {post.data.categories.length > 0 && (
              <>
                <span class="meta-sep" aria-hidden="true">·</span>
                <span class="post-categories">
                  {post.data.categories.map((cat) => (
                    <span class="category-tag">{cat}</span>
                  ))}
                </span>
              </>
            )}
          </p>
        </header>

        <div class="post-content">
          <slot />
        </div>

        <nav class="post-nav" aria-label="文章导航">
          <div class="post-nav-grid">
            {prev ? (
              <a class="nav-link nav-prev" href={`/blog/${postSlug(prev)}/`}>
                <span class="nav-label">← 上一篇</span>
                <span class="nav-title">{prev.data.title}</span>
              </a>
            ) : (
              <span class="nav-link nav-disabled" aria-hidden="true"></span>
            )}

            {next ? (
              <a class="nav-link nav-next" href={`/blog/${postSlug(next)}/`}>
                <span class="nav-label">下一篇 →</span>
                <span class="nav-title">{next.data.title}</span>
              </a>
            ) : (
              <span class="nav-link nav-disabled" aria-hidden="true"></span>
            )}
          </div>
        </nav>
      </div>

      <aside class="post-sidebar" aria-label="文章信息">
        {tocHeadings.length > 0 && (
          <nav class="sidebar-section toc" aria-label="目录">
            <h2 class="sidebar-heading">目录</h2>
            <ul class="toc-list">
              {tocHeadings.map((h) => (
                <li class={`toc-item toc-depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {post.data.tags.length > 0 && (
          <div class="sidebar-section">
            <h2 class="sidebar-heading">标签</h2>
            <div class="sidebar-tags">
              {post.data.tags.map((tag) => (
                <span class="sidebar-tag">{tag}</span>
              ))}
            </div>
          </div>
        )}

        {recentPosts.length > 0 && (
          <div class="sidebar-section">
            <h2 class="sidebar-heading">最近文章</h2>
            <ul class="recent-list">
              {recentPosts.map((p) => (
                <li>
                  <a href={`/blog/${postSlug(p)}/`}>{p.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  // Scrollspy: highlight current TOC entry
  (function () {
    var tocLinks = document.querySelectorAll('.toc-list a');
    if (!tocLinks.length) return;

    var headingMap: Record<string, Element> = {};
    tocLinks.forEach(function (link) {
      var id = link.getAttribute('href');
      if (!id) return;
      var el = document.getElementById(id.slice(1));
      if (el) headingMap[id.slice(1)] = link;
    });

    var targets = Object.keys(headingMap)
      .map(function (id) { return document.getElementById(id); })
      .filter(Boolean);

    if (!targets.length) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          var link = headingMap[entry.target.getAttribute('id')];
          if (!link) return;
          if (entry.isIntersecting) {
            tocLinks.forEach(function (l) { l.classList.remove('is-active'); });
            link.classList.add('is-active');
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );

    targets.forEach(function (t) { observer.observe(t); });
  })();
</script>

<style is:global>
  /* Article prose — global because Markdown HTML flows through here. */
  .post-content {
    padding-bottom: 3rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text);
  }
  .post-content h2,
  .post-content h3,
  .post-content h4 {
    margin-top: 2.5rem;
    scroll-margin-top: 5rem;
  }

  .post-content img {
    border-radius: var(--radius);
    margin: 2rem auto;
    border: 1px solid var(--border);
  }

  .post-content figure { margin: 2rem 0; }
  .post-content figure figcaption {
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-top: 0.5rem;
    font-style: italic;
  }

  .post-content blockquote {
    border-left: 3px solid var(--brand);
    padding-left: 1.25rem;
    margin-left: 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .post-content code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface-2);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
  }

  .post-content pre {
    background: var(--code-bg);
    color: var(--text);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    overflow-x: auto;
    border: 1px solid var(--border);
    font-size: 0.875rem;
    line-height: 1.65;
    margin: 1.5rem 0;
  }
  .post-content pre code {
    background: transparent;
    padding: 0;
    font-size: inherit;
  }

  .post-content table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .post-content th,
  .post-content td {
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .post-content th {
    color: var(--text-muted);
    font-weight: 600;
  }

  .post-content hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }
</style>

<style>
  /* ---------- Two-column layout ---------- */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 3rem;
    align-items: start;
  }

  .post-main { min-width: 0; }

  .post-header { padding: 3.5rem 0 2rem; }

  .post-header .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-family: var(--font-serif);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .post-meta {
    color: var(--text-tertiary);
    font-size: 0.875rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .meta-sep { color: var(--text-tertiary); }
  .post-categories { display: inline-flex; gap: 0.25rem; flex-wrap: wrap; }

  .category-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.125rem 0.5rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ---------- Post nav ---------- */
  .post-nav {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .nav-link {
    display: block;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: all var(--t-fast);
    text-decoration: none;
    color: var(--text);
  }
  .nav-link:hover {
    border-color: var(--brand);
    background: var(--surface-2);
    color: var(--text);
  }
  .nav-link.nav-next { text-align: right; }
  .nav-link.nav-disabled {
    border: none;
    background: transparent;
    padding: 1rem 0;
  }

  .nav-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
  }

  .nav-title {
    font-family: var(--font-serif);
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.4;
    display: block;
  }

  /* ---------- Sidebar ---------- */
  .post-sidebar {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  .sidebar-section {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .sidebar-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .sidebar-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  /* TOC */
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-item { margin: 0; }
  .toc-item a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color var(--t-fast), border-color var(--t-fast);
    line-height: 1.5;
  }
  .toc-item a:hover {
    color: var(--text);
  }
  .toc-item a.is-active {
    color: var(--brand-strong);
    border-left-color: var(--brand);
  }
  .toc-depth-3 a {
    padding-left: 1.5rem;
    font-size: 0.75rem;
  }

  /* Tags */
  .sidebar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .sidebar-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.2rem 0.5rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    letter-spacing: 0.03em;
  }

  /* Recent posts */
  .recent-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .recent-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .recent-list li:last-child { border-bottom: none; }
  .recent-list a {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.5;
    transition: color var(--t-fast);
  }
  .recent-list a:hover { color: var(--brand-strong); }

  /* ---------- Responsive ---------- */
  @media (max-width: 1023px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
    .post-sidebar {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .post-nav-grid { grid-template-columns: 1fr; }
    .post-content { font-size: 1rem; }
  }
</style>
