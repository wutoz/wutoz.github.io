---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  pageType?: 'website' | 'article';
}

const {
  title,
  description = '梧桐的个人技术博客。iOS / Android / HarmonyOS 三端、AI 与证券应用、移动端架构与工程实践。',
  pageType = 'website',
} = Astro.props;

const fullTitle = title === '梧桐' ? `${title} — 移动前端技术专家 / 全栈工程师` : `${title} — 梧桐`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0c1320" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="梧桐 RSS" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="梧桐" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
  </head>

  <body class="theme-dark">
    <a class="skip-link" href="#main">跳到主要内容</a>

    <Header />

    <main id="main" class="site-main">
      <slot />
    </main>

    <Footer />

    <script>
      // ============================================================
      // 客户端：dark/light 切换 + 系统偏好 + 外链补全
      // ============================================================
      (function () {
        'use strict';
        const KEY = 'wutong-theme';

        function getStored() {
          try { return localStorage.getItem(KEY); } catch (_) { return null; }
        }
        function setStored(t) {
          try { localStorage.setItem(KEY, t); } catch (_) {}
        }
        function systemPrefers() {
          return window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light' : 'dark';
        }
        function apply(t) {
          document.body.classList.remove('theme-dark', 'theme-light');
          document.body.classList.add('theme-' + t);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', t === 'light' ? '#fbfbfe' : '#0c1320');
          var btn = document.querySelector('.theme-toggle');
          if (btn) btn.setAttribute('aria-pressed', String(t === 'light'));
        }

        apply(getStored() || systemPrefers());

        document.addEventListener('click', function (e) {
          var t = e.target;
          if (t && t.closest && t.closest('.theme-toggle')) {
            var next = document.body.classList.contains('theme-light') ? 'dark' : 'light';
            apply(next);
            setStored(next);
          }
        });

        if (window.matchMedia) {
          var mq = window.matchMedia('(prefers-color-scheme: light)');
          var listener = function (e) { if (!getStored()) apply(e.matches ? 'light' : 'dark'); };
          if (mq.addEventListener) mq.addEventListener('change', listener);
          else if (mq.addListener) mq.addListener(listener);
        }

        // External links: target=_blank + rel=noopener
        document.querySelectorAll('a[href^="http"]').forEach(function (a) {
          if (a.host !== window.location.host && !a.hasAttribute('target')) {
            a.setAttribute('target', '_blank');
            a.setAttribute('rel', 'noopener noreferrer');
          }
        });
      })();
    </script>

    <style>
      .site-main { min-height: 70vh; padding: 1rem 0 4rem; }
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--brand);
        color: white;
        padding: 8px 16px;
        z-index: 100;
        text-decoration: none;
        border-radius: 0 0 var(--radius) 0;
      }
      .skip-link:focus { top: 0; }
    </style>
  </body>
</html>
